# Rename this file to .env and fill in your own values

PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/foodprint

# Secret used to sign JWT tokens - use a long random string
JWT_SECRET=replace_this_with_a_long_random_secret

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# AI assistant (optional). Free key from https://aistudio.google.com/apikey
# Without a key the assistant still works using built-in rule-based insights.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
